{
  "name": "@agentflow/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "migrate:create": "node-pg-migrate create -m migrations -j sql",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentflow/db": "*",
    "@agentflow/types": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "vitest": "^5.0.5"
  }
}
