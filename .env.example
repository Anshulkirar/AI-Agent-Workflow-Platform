# --- Infrastructure ---
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentflow
REDIS_PASSWORD=change-me

# --- Host ports ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000

# --- Auth service ---
# Password for the auth_service Postgres role (created on first database start).
AUTH_DB_PASSWORD=change-me
# Local dev only (services on the host). Docker Compose builds its own URL.
AUTH_DATABASE_URL=postgres://auth_service:change-me@127.0.0.1:5432/agentflow_auth
AUTH_TEST_DATABASE_URL=postgres://auth_service:change-me@127.0.0.1:5432/agentflow_auth_test
# Session cookies are Secure in production. Set to false only if you serve the
# Docker stack over plain HTTP on something other than localhost.
# COOKIE_SECURE=false

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
