# --- Infrastructure ---
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentflow
REDIS_PASSWORD=change-me

# --- Host ports ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000

# --- Auth service ---
# Password for the auth_service Postgres role (created on first database start).
AUTH_DB_PASSWORD=change-me
# Local dev only (services on the host). Docker Compose builds its own URL.
AUTH_DATABASE_URL=postgres://auth_service:change-me@127.0.0.1:5432/agentflow_auth
AUTH_TEST_DATABASE_URL=postgres://auth_service:change-me@127.0.0.1:5432/agentflow_auth_test

# --- Workflow service ---
WORKFLOW_DB_PASSWORD=change-me
WORKFLOW_DATABASE_URL=postgres://workflow_service:change-me@127.0.0.1:5432/agentflow_workflow
WORKFLOW_TEST_DATABASE_URL=postgres://workflow_service:change-me@127.0.0.1:5432/agentflow_workflow_test
# Session cookies are Secure in production. Set to false only if you serve the
# Docker stack over plain HTTP on something other than localhost.
# COOKIE_SECURE=false


# --- Agent service ---
AGENT_DB_PASSWORD=change-me
AGENT_DATABASE_URL=postgres://agent_service:change-me@127.0.0.1:5432/agentflow_agent
AGENT_TEST_DATABASE_URL=postgres://agent_service:change-me@127.0.0.1:5432/agentflow_agent_test
# --- Execution service ---
EXECUTION_DB_PASSWORD=change-me
EXECUTION_DATABASE_URL=postgres://execution_service:change-me@127.0.0.1:5432/agentflow_execution
EXECUTION_TEST_DATABASE_URL=postgres://execution_service:change-me@127.0.0.1:5432/agentflow_execution_test

# --- Tools service ---
TOOLS_DB_PASSWORD=change-me
KNOWLEDGE_DB_PASSWORD=change-me
TOOLS_DATABASE_URL=postgres://tools_service:change-me@127.0.0.1:5432/agentflow_tools
TOOLS_TEST_DATABASE_URL=postgres://tools_service:change-me@127.0.0.1:5432/agentflow_tools_test
# Use a unique secret of at least 32 characters in each environment.
TOOL_CREDENTIALS_KEY=replace-with-a-random-secret-at-least-32-characters

# --- API gateway (all optional) ---
# Requests per client IP per minute, across all services (health checks excluded).
# RATE_LIMIT_MAX=300
# Local dev counts per process; set this to share counters through the Compose Redis.
# REDIS_URL=redis://:change-me@127.0.0.1:6379
# UPSTREAM_TIMEOUT_MS=10000

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
